COMMANDS USED
================================================================================

### Define Groups OU
$GroupsOU = "OU=Groups,OU=Engineering Company,DC=engineering,DC=local"


### Create Engineering group
New-ADGroup `
    -Name "GG-Engineering" `
    -SamAccountName "GG-Engineering" `
    -GroupScope Global `
    -GroupCategory Security `
    -Path $GroupsOU


### Create IT group
New-ADGroup `
    -Name "GG-IT" `
    -SamAccountName "GG-IT" `
    -GroupScope Global `
    -GroupCategory Security `
    -Path $GroupsOU


### Create Management group
New-ADGroup `
    -Name "GG-Management" `
    -SamAccountName "GG-Management" `
    -GroupScope Global `
    -GroupCategory Security `
    -Path $GroupsOU


### Verify groups
Get-ADGroup `
    -SearchBase "OU=Groups,OU=Engineering Company,DC=engineering,DC=local" `
    -Filter * |
    Select-Object Name, SamAccountName, GroupScope, GroupCategory


### Assign users
Add-ADGroupMember `
    -Identity "GG-Engineering" `
    -Members "alice.miller"

Add-ADGroupMember `
    -Identity "GG-IT" `
    -Members "john.smith"

Add-ADGroupMember `
    -Identity "GG-Management" `
    -Members "sarah.wilson"


### Verify membership
Get-ADGroupMember "GG-Engineering" |
    Select-Object Name, SamAccountName, ObjectClass

Get-ADGroupMember "GG-IT" |
    Select-Object Name, SamAccountName, ObjectClass

Get-ADGroupMember "GG-Management" |
    Select-Object Name, SamAccountName, ObjectClass


