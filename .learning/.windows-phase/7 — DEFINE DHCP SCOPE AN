### Authorize DHCP server in Active Directory

Add-DhcpServerInDC `
    -DnsName "DC01.engineering.local" `
    -IPAddress 192.168.100.20


### Verify DHCP authorization

Get-DhcpServerInDC


### Create DHCP scope

Add-DhcpServerv4Scope `
    -Name "Engineering Lab" `
    -StartRange 192.168.100.50 `
    -EndRange 192.168.100.100 `
    -SubnetMask 255.255.255.0 `
    -State Active


### Configure DHCP scope options

Set-DhcpServerv4OptionValue `
    -ScopeId 192.168.100.0 `
    -Router 192.168.100.1 `
    -DnsServer 192.168.100.20 `
    -DnsDomain "engineering.local"


### Verify scope

Get-DhcpServerv4Scope


### Verify DHCP options

Get-DhcpServerv4OptionValue `
    -ScopeId 192.168.100.0


### Configure WIN01 DHCP reservation

Add-DhcpServerv4Reservation `
    -ScopeId 192.168.100.0 `
    -IPAddress 192.168.100.30 `
    -ClientId "52-54-00-CD-78-97" `
    -Name "WIN01" `
    -Description "WIN01 domain workstation"


### Verify reservation

Get-DhcpServerv4Reservation `
    -ScopeId 192.168.100.0


