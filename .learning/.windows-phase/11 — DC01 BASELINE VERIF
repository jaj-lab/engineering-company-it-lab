### Verify hostname

hostname


### Verify OS, domain and domain role

Get-ComputerInfo |
    Select-Object `
        CsName,
        WindowsProductName,
        WindowsVersion,
        OsBuildNumber,
        CsDomain,
        CsDomainRole


### Verify domain membership

Get-CimInstance Win32_ComputerSystem |
    Select-Object `
        Name,
        Domain,
        PartOfDomain,
        DomainRole


### Verify critical services

Get-Service `
    NTDS,
    DNS,
    DHCPServer,
    W32Time,
    WinRM |
    Select-Object Name, Status, StartType


### Verify Windows Time service

Get-Service W32Time


### Verify time synchronization status

w32tm /query /status


### Verify Windows Time configuration

w32tm /query /configuration


### Verify current system time

Get-Date


### Verify WinRM

Get-Service WinRM


### Verify WinRM configuration

winrm quickconfig


### Verify WinRM listener

winrm enumerate winrm/config/listener


### Verify WS-Man

Test-WSMan localhost


### Verify firewall profiles

Get-NetFirewallProfile |
    Select-Object `
        Name,
        Enabled,
        DefaultInboundAction,
        DefaultOutboundAction


### Verify installed Windows Server roles/features

Get-WindowsFeature |
    Where-Object Installed |
    Select-Object Name, DisplayName


### Verify recent Windows updates

Get-HotFix |
    Sort-Object InstalledOn -Descending |
    Select-Object -First 10 `
        HotFixID,
        Description,
        InstalledOn
