================================================================================
COMMANDS USED
================================================================================

### Create Alice Miller
New-ADUser `
    -Name "Alice Miller" `
    -GivenName "Alice" `
    -Surname "Miller" `
    -SamAccountName "alice.miller" `
    -UserPrincipalName "alice.miller@engineering.local" `
    -Path "OU=Users,OU=Engineering Company,DC=engineering,DC=local" `
    -AccountPassword (Read-Host "Enter password" -AsSecureString) `
    -Enabled $true


### Create John Smith
New-ADUser `
    -Name "John Smith" `
    -GivenName "John" `
    -Surname "Smith" `
    -SamAccountName "john.smith" `
    -UserPrincipalName "john.smith@engineering.local" `
    -Path "OU=Users,OU=Engineering Company,DC=engineering,DC=local" `
    -AccountPassword (Read-Host "Enter password" -AsSecureString) `
    -Enabled $true


### Create Sarah Wilson
New-ADUser `
    -Name "Sarah Wilson" `
    -GivenName "Sarah" `
    -Surname "Wilson" `
    -SamAccountName "sarah.wilson" `
    -UserPrincipalName "sarah.wilson@engineering.local" `
    -Path "OU=Users,OU=Engineering Company,DC=engineering,DC=local" `
    -AccountPassword (Read-Host "Enter password" -AsSecureString) `
    -Enabled $true


### Verify users
Get-ADUser `
    -SearchBase "OU=Users,OU=Engineering Company,DC=engineering,DC=local" `
    -Filter * `
    -Properties UserPrincipalName, Enabled |
    Select-Object Name, SamAccountName, UserPrincipalName, Enabled


