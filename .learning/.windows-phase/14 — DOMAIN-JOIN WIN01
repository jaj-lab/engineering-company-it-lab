### Verify hostname

hostname


### Verify OS and current domain state

Get-ComputerInfo |
    Select-Object `
        CsName,
        WindowsProductName,
        WindowsVersion,
        OsBuildNumber,
        CsDomain,
        CsDomainRole


### Verify current domain membership

Get-CimInstance Win32_ComputerSystem |
    Select-Object `
        Name,
        Domain,
        PartOfDomain,
        DomainRole


### Verify network adapter

Get-NetAdapter |
    Select-Object `
        Name,
        InterfaceDescription,
        Status,
        MacAddress


### Verify IP configuration

Get-NetIPConfiguration


### Verify configured DNS servers

Get-DnsClientServerAddress |
    Where-Object AddressFamily -eq 2


### Verify gateway connectivity

Test-Connection 192.168.100.1 -Count 2


### Verify DC connectivity

Test-Connection 192.168.100.20 -Count 2


### Verify domain DNS resolution

Resolve-DnsName engineering.local


### Verify DC DNS resolution

Resolve-DnsName DC01.engineering.local


### Verify Active Directory LDAP SRV record

Resolve-DnsName `
    _ldap._tcp.dc._msdcs.engineering.local `
    -Type SRV


### Discover domain controller

nltest /dsgetdc:engineering.local


### Verify DNS connectivity

Test-NetConnection 192.168.100.20 -Port 53


### Verify LDAP connectivity

Test-NetConnection 192.168.100.20 -Port 389


### Final domain discovery check

nltest /dsgetdc:engineering.local
