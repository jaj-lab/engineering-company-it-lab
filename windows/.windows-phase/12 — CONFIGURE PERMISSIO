### Verify organizational units

Get-ADOrganizationalUnit -Filter * |
    Select-Object Name, DistinguishedName


### Verify role-based security groups

Get-ADGroup `
    -Filter 'Name -like "GG-*"' |
    Select-Object Name, GroupScope, GroupCategory


### Verify Engineering group membership

Get-ADGroupMember GG-Engineering


### Verify IT group membership

Get-ADGroupMember GG-IT


### Verify Management group membership

Get-ADGroupMember GG-Management


### Verify CompanyData structure

Get-ChildItem C:\CompanyData


### Verify Engineering NTFS permissions

Get-Acl "C:\CompanyData\Engineering" |
    Select-Object -ExpandProperty Access


### Verify IT NTFS permissions

Get-Acl "C:\CompanyData\IT" |
    Select-Object -ExpandProperty Access


### Verify Management NTFS permissions

Get-Acl "C:\CompanyData\Management" |
    Select-Object -ExpandProperty Access


### Verify Engineering ACL with icacls

icacls "C:\CompanyData\Engineering"


### Verify IT ACL with icacls

icacls "C:\CompanyData\IT"


### Verify Management ACL with icacls

icacls "C:\CompanyData\Management"
